# Postgres (docker compose up -d). If 5432 is taken locally, set POSTGRES_PORT=5433
# and change the port in both URLs below.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal?schema=public"
DATABASE_URL_TEST="postgresql://portal:portal@localhost:5432/portal_test?schema=public"

# Public origin of the app; used for the CSRF Origin check on mutating requests.
APP_URL="http://localhost:3000"

# Session lifetime in days.
SESSION_TTL_DAYS=7
