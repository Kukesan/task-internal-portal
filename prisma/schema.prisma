generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum Role {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  /// citext gives case-insensitive uniqueness; the app also lowercases on input.
  email        String   @unique @db.Citext
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  sessions      Session[]
  createdTasks  Task[]    @relation("TaskCreatedBy")
  assignedTasks Task[]    @relation("TaskAssignee")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the raw cookie token; the raw token is never stored.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Task {
  id          String     @id @default(cuid())
  title       String     @db.VarChar(120)
  description String?    @db.VarChar(2000)
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  /// A calendar date, not an instant, so it is stored without a time zone.
  dueDate     DateTime?  @db.Date
  createdById String
  assigneeId  String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  createdBy User  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([assigneeId])
  @@index([status])
  @@index([assigneeId, status])
  @@map("tasks")
}
